{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "jsx": "react-jsx",
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    "paths": {
      "#/*": ["./src/*"],
      "@harborclient/core": ["../../packages/core/src/index.ts"],
      "@harborclient/core/*": ["../../packages/core/src/*"],
      "@harborclient/storage-sqlite": ["../../packages/storage-sqlite/src/index.ts"],
      "@harborclient/storage-sqlite/*": ["../../packages/storage-sqlite/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "electron.vite.config.ts"]
}
