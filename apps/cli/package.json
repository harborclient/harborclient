{
  "name": "@harborclient/cli",
  "version": "0.1.0",
  "description": "HarborClient command-line runner — HTTPie-style API client powered by @harborclient/core.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
