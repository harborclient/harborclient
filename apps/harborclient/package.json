{
  "name": "@harborclient/harborclient",
  "productName": "HarborClient",
  "version": "2.10.1",
  "private": true,
  "description": "HarborClient is a native desktop API workbench for building, sending, and inspecting HTTP requests. Debug what actually went over the wire, keep collections close to your development workflow, and share them through Git, Postgres, MySQL, Firestore, and more.",
  "main": "../gui/out/main/index.js",
  "desktopName": "harborclient",
  "homepage": "https://harborclient.com/",
  "author": {
    "name": "HarborClient",
    "email": "contact@harborclient.com"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "dist": "node ./scripts/dist.mjs",
    "dist:deb": "node ./scripts/dist.mjs --linux deb --publish never",
    "dist:rpm": "node ./scripts/dist.mjs --linux rpm --publish never",
    "dist:linux": "node ./scripts/dist.mjs --linux --publish never",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@harborclient/gui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^42.6.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  }
}
