{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@harborclient/core": ["../core/src/index.ts"],
      "@harborclient/core/*": ["../core/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
