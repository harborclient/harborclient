{
  "name": "@harborclient/core",
  "version": "0.1.0",
  "description": "Platform-neutral HarborClient engine: types, request orchestration helpers, and shared utilities.",
  "license": "MIT",
  "author": {
    "name": "HarborClient",
    "email": "contact@harborclient.com"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*",
      "default": "./src/*"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "eslint --cache .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:build": "pnpm docs:build:nav && vitepress build docs",
    "docs:build:nav": "node scripts/build-docs-nav.mjs && node scripts/assert-docs-slugs.mjs",
    "docs:preview": "pnpm docs:build && vitepress preview docs",
    "docs:serve": "pnpm docs:build:nav && concurrently --kill-others --prefixColors=auto -n nav,vp \"node scripts/watch-docs-nav.mjs\" \"vitepress dev docs\""
  },
  "dependencies": {
    "@harborclient/http": "1.0.0",
    "@harborclient/sdk": "1.1.33",
    "@harborclient/team-hub-api": "0.4.0",
    "@orama/orama": "^3.1.18",
    "chai": "^4.5.0",
    "cheerio": "^1.2.0",
    "esbuild": "^0.25.12",
    "jmespath": "^0.16.0",
    "js-yaml": "^5.2.2",
    "openai": "^6.44.0",
    "papaparse": "^5.5.4",
    "ses": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@types/chai": "^4.3.20",
    "@types/jmespath": "^0.15.2",
    "@types/js-yaml": "^4.0.9",
    "@types/papaparse": "^5.5.2",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.4",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.9"
  }
}
