{
  "name": "@harborclient/core",
  "version": "0.2.0",
  "description": "Platform-neutral HarborClient engine: types, request orchestration helpers, and shared utilities.",
  "homepage": "https://harborclient.github.io/harborclient/core/",
  "bugs": {
    "url": "https://github.com/harborclient/harborclient/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harborclient/harborclient.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": {
    "name": "HarborClient",
    "email": "contact@harborclient.com"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*",
      "default": "./src/*"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*",
        "import": "./dist/*",
        "default": "./dist/*"
      }
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @harborclient/sdk build && pnpm --filter @harborclient/http build",
    "build": "tsc -p tsconfig.build.json && node scripts/assert-dist-publishable.mjs",
    "clean": "rm -rf dist && find src -type f \\( -name '*.js' -o -name '*.d.ts' -o -name '*.js.map' -o -name '*.d.ts.map' \\) -delete",
    "lint": "eslint --cache .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:watch": "vitest",
    "docs:build": "pnpm docs:build:nav && vitepress build docs",
    "docs:build:nav": "node scripts/build-docs-nav.mjs && node scripts/assert-docs-slugs.mjs",
    "docs:preview": "pnpm docs:build && vitepress preview docs",
    "docs:serve": "pnpm docs:build:nav && concurrently --kill-others --prefixColors=auto -n nav,vp \"node scripts/watch-docs-nav.mjs\" \"vitepress dev docs\"",
    "release": "gh workflow run core-release.yml --ref main -f branch=main -f bump=patch",
    "release:patch": "gh workflow run core-release.yml --ref main -f branch=main -f bump=patch",
    "release:minor": "gh workflow run core-release.yml --ref main -f branch=main -f bump=minor",
    "release:major": "gh workflow run core-release.yml --ref main -f branch=main -f bump=major"
  },
  "dependencies": {
    "@harborclient/http": "workspace:^",
    "@harborclient/sdk": "workspace:^",
    "@harborclient/team-hub-api": "0.4.0",
    "@orama/orama": "^3.1.18",
    "chai": "^4.5.0",
    "cheerio": "^1.2.0",
    "esbuild": "^0.25.12",
    "jmespath": "^0.16.0",
    "js-yaml": "^5.2.2",
    "openai": "^6.44.0",
    "papaparse": "^5.5.4",
    "ses": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@types/chai": "^4.3.20",
    "@types/jmespath": "^0.15.2",
    "@types/js-yaml": "^4.0.9",
    "@types/papaparse": "^5.5.2",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.4",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.9"
  }
}
