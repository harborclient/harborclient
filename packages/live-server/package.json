{
  "name": "@harborclient/live-server",
  "version": "0.1.2",
  "description": "Headless live-server host for HarborClient (Express static server, scripts, run command).",
  "keywords": [
    "harborclient",
    "live-server",
    "express",
    "typescript"
  ],
  "homepage": "https://harborclient.com/live-server/",
  "bugs": {
    "url": "https://github.com/harborclient/harborclient/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harborclient/harborclient.git",
    "directory": "packages/live-server"
  },
  "license": "MIT",
  "author": {
    "name": "HarborClient",
    "email": "contact@harborclient.com"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*",
      "default": "./src/*"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*",
        "import": "./dist/*",
        "default": "./dist/*"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "eslint --cache .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:watch": "vitest",
    "docs:build": "pnpm docs:build:nav && vitepress build docs",
    "docs:build:nav": "node scripts/build-docs-nav.mjs && node scripts/assert-docs-slugs.mjs",
    "docs:preview": "pnpm docs:build && vitepress preview docs",
    "docs:serve": "pnpm docs:build:nav && concurrently --kill-others --prefixColors=auto -n nav,vp \"node scripts/watch-docs-nav.mjs\" \"vitepress dev docs\"",
    "release": "gh workflow run live-server-release.yml --ref main -f branch=main -f bump=patch",
    "release:patch": "gh workflow run live-server-release.yml --ref main -f branch=main -f bump=patch",
    "release:minor": "gh workflow run live-server-release.yml --ref main -f branch=main -f bump=minor",
    "release:major": "gh workflow run live-server-release.yml --ref main -f branch=main -f bump=major"
  },
  "dependencies": {
    "@harborclient/core": "workspace:^",
    "@harborclient/sdk": "workspace:^",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.4",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.9"
  }
}
