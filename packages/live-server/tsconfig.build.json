{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@harborclient/core": ["../core/dist/index.d.ts"],
      "@harborclient/core/*": ["../core/dist/*"],
      "@harborclient/sdk": ["../sdk/dist/index.d.ts"],
      "@harborclient/sdk/*": ["../sdk/dist/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
