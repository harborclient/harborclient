# Image tag to pull from GitHub Container Registry (without the registry prefix).
# Examples: latest, 0.7.6, 0.7
APP_VERSION=latest

# Host port mapped to the container HTTP port (Nginx listens on 8080 inside the image).
HOST_PORT=8080

# Strong database password for bundled Postgres. Change before exposing the service publicly.
# Also used by compose.external.reference.yaml for the separate Postgres container.
TEAM_HUB_DB_PASSWORD=change-me

# Optional: set to false when using external Postgres or Redis (see deploy documentation).
# TEAM_HUB_START_POSTGRES=true
# TEAM_HUB_START_REDIS=true

# Optional: skip migrate on container start (default false). Use true for multi-replica
# deploys after running migrate once as a Job / one-off container.
# TEAM_HUB_SKIP_MIGRATE=false

# Optional: enable Redis pub/sub for multi-instance notice SSE fan-out (default false).
# TEAM_HUB_REDIS_NOTICE_EVENTS_PUBSUB=false

# Optional: force-exit deadline after SIGTERM/SIGINT in ms (default 25000).
# Must be less than Docker/K8s/Cloud Run stop grace (typically 30–60s).
# TEAM_HUB_SHUTDOWN_TIMEOUT_MS=25000

# ---------------------------------------------------------------------------
# External Postgres + Redis (compose.external.yaml / compose.external.reference.yaml)
# ---------------------------------------------------------------------------
# For app-only deploys against managed or separate Postgres/Redis, set the
# following. compose.external.yaml and compose.external.reference.yaml also
# hardcode TEAM_HUB_START_POSTGRES/REDIS=false so .env mistakes cannot re-enable
# bundled services.
#
# Connection sizing: replicas × TEAM_HUB_DB_MAX ≤ max_connections × 0.75
# See packages/team-hub/docs/configuration.md (Pool sizing).
#
# TEAM_HUB_START_POSTGRES=false
# TEAM_HUB_START_REDIS=false
# TEAM_HUB_DB_HOST=db.example.com
# TEAM_HUB_DB_PORT=5432
# TEAM_HUB_DB_USER=harbor
# TEAM_HUB_DB_DATABASE=harbor
# TEAM_HUB_REDIS_HOST=redis.example.com
# TEAM_HUB_REDIS_PORT=6379
#
# Optional pool / TLS (managed Postgres often needs SSL):
# TEAM_HUB_DB_MAX=10
# TEAM_HUB_DB_SSL=true
#
# Multi-replica (scale > 1): migrate once, then skip migrate on serve + enable
# notice pub/sub so SSE fans out across instances:
# TEAM_HUB_SKIP_MIGRATE=true
# TEAM_HUB_REDIS_NOTICE_EVENTS_PUBSUB=true
#
# Host-managed Postgres/Redis via the package docker-compose.yml (ports 5435/6380):
# TEAM_HUB_DB_HOST=host.docker.internal
# TEAM_HUB_DB_PORT=5435
# TEAM_HUB_REDIS_HOST=host.docker.internal
# TEAM_HUB_REDIS_PORT=6380
