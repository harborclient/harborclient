# Operator worksheet for Kubernetes ConfigMap / Secret values.
# This file is not consumed by kubectl or Kustomize — copy values into
# packages/team-hub/deploy/k8s/base/configmap.yaml and create the Secret.
#
# Image: ghcr.io/harborclient/team-hub:<version>
# See packages/team-hub/docs/deploy/k8s.md

# --- Required (external Postgres + Redis) ---
TEAM_HUB_DB_HOST=postgres.example.com
TEAM_HUB_DB_PORT=5432
TEAM_HUB_DB_USER=harbor
TEAM_HUB_DB_PASSWORD=change-me
TEAM_HUB_DB_DATABASE=harbor
TEAM_HUB_REDIS_HOST=redis.example.com
TEAM_HUB_REDIS_PORT=6379

# --- Multi-replica (required for ≥2 pods) ---
TEAM_HUB_START_POSTGRES=false
TEAM_HUB_START_REDIS=false
TEAM_HUB_SKIP_MIGRATE=true
TEAM_HUB_REDIS_NOTICE_EVENTS_PUBSUB=true

# --- Pool / TLS ---
# Static: replicas × TEAM_HUB_DB_MAX ≤ max_connections × 0.75
# With HPA (base/hpa.yaml): maxReplicas × TEAM_HUB_DB_MAX ≤ max_connections × 0.75
# Example HPA defaults: minReplicas=2, maxReplicas=10 — lower maxReplicas or
# TEAM_HUB_DB_MAX if Postgres cannot support peak scale.
TEAM_HUB_DB_MAX=10
TEAM_HUB_DB_SSL=true

# --- Logging + metrics (console for pod logs; scrape /metrics on pod network) ---
TEAM_HUB_LOGGING_CONSOLE=true
TEAM_HUB_LOGGING_LEVEL=info
TEAM_HUB_LOGGING_FORMAT=json
TEAM_HUB_METRICS_ENABLED=true
TEAM_HUB_METRICS_PATH=/metrics
# Optional: TEAM_HUB_METRICS_AUTH_TOKEN=scrape-secret

# --- Shutdown (must be below terminationGracePeriodSeconds, default 30) ---
TEAM_HUB_SHUTDOWN_TIMEOUT_MS=25000

# --- Ingress hostname (edit ingress.yaml / ingress-notices.yaml) ---
# TEAM_HUB_INGRESS_HOST=team-hub.example.com
