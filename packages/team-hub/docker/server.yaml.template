server:
  port: ${TEAM_HUB_PORT}
  host: ${TEAM_HUB_HOST}

db:
  driver: ${TEAM_HUB_DB_DRIVER}
  host: ${TEAM_HUB_DB_HOST}
  port: ${TEAM_HUB_DB_PORT}
  user: ${TEAM_HUB_DB_USER}
  password: ${TEAM_HUB_DB_PASSWORD}
  database: ${TEAM_HUB_DB_DATABASE}

redis:
  host: ${TEAM_HUB_REDIS_HOST}
  port: ${TEAM_HUB_REDIS_PORT}
  # Optional: set to true when multiple Team Hub app instances share Redis for notice SSE fan-out.
  # noticeEventsPubSub: false

logging:
  level: ${TEAM_HUB_LOGGING_LEVEL}
  file: ${TEAM_HUB_LOGGING_FILE}
  console: ${TEAM_HUB_LOGGING_CONSOLE}

multitenancy:
  enabled: ${TEAM_HUB_MULTITENANCY_ENABLED}

# Optional: enable hub-wide encrypted discussion bodies (requires client device enrollment).
# collaboration:
#   e2ee: false
