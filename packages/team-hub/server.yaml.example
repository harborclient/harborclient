# Team Hub server configuration.
# Copy to server.yaml and adjust for your environment.
#
# Required sections: server, db, redis
# Optional sections: logging, metrics, storage, llm, plugins, docs, multitenancy, collaboration
#
# While team-hub start is running, db/redis/llm/plugins/docs/collaboration/storage reload live via
# SIGHUP or POST /admin/config/reload. Changes to server.host, server.port, logging, metrics, or
# multitenancy.enabled require a restart.
#
# Environment interpolation: string values may use ${NAME} or ${NAME:-default}. The process
# resolves placeholders from the environment at load and on each reload. Use $${NAME} for a
# literal ${NAME}. Prefer placeholders for secrets so they are not stored in the YAML file:
#   password: ${TEAM_HUB_DB_PASSWORD}
#   apiKey: ${TEAM_HUB_LLM_OPENAI_API_KEY:-}

# HTTP listen address for the Team Hub API.
server:
  port: 8787
  host: 127.0.0.1

# Optional logging. Defaults: level info, console true, format json, no file.
# Applied at process startup; restart team-hub start after changes.
# Use format: json for Loki / Cloud Logging; format: simple for local terminals.
#
# logging:
#   level: debug
#   file: /var/log/team-hub.log
#   console: true
#   format: json

# Optional Prometheus metrics. Defaults: enabled true, path /metrics, no auth.
# Keep /metrics off public Ingress; use NetworkPolicy or metrics.authToken.
#
# metrics:
#   enabled: true
#   path: /metrics
#   authToken: ""

# Database backend. Set driver to postgres, mysql, or firestore.
# host is a single endpoint (primary or pooler). No app-level read replicas —
# see docs/configuration.md (Read replicas and connection pooling).
#
# Postgres (default for local development with docker compose):
db:
  driver: postgres
  host: 127.0.0.1
  port: 5432
  user: harbor
  # Local default; production: password: ${TEAM_HUB_DB_PASSWORD}
  password: harbor
  database: harbor
  # Optional pool tuning. Set max per replica so:
  #   replicas × max ≤ database max_connections × ~0.75
  # max: 10
  # idleTimeoutMillis: 10000
  # connectionTimeoutMillis: 2000
  # ssl: true
  # ssl:
  #   rejectUnauthorized: true
  #   ca: |
  #     -----BEGIN CERTIFICATE-----
  #     ...

# MySQL alternative:
# db:
#   driver: mysql
#   host: 127.0.0.1
#   port: 3306
#   user: harbor
#   password: harbor
#   database: harbor
#   # Optional pool tuning (max maps to mysql2 connectionLimit):
#   # max: 10
#   # idleTimeoutMillis: 10000
#   # connectionTimeoutMillis: 2000
#   # ssl: true


# Firestore alternative:
# db:
#   driver: firestore
#   projectId: my-gcp-project
#   keyFilename: /path/to/service-account.json

# Redis is required for authentication throttling.
# Optional throttle policy fields default to 10 failures / 900s window / 900s block.
# Set noticeEventsPubSub: true when multiple app instances share Redis for notice SSE fan-out.
redis:
  host: 127.0.0.1
  port: 6380
  # password: redis-secret
  # db: 0
  # keyPrefix: team-hub:
  # maxFailures: 10
  # windowSeconds: 900
  # blockSeconds: 900
  # noticeEventsPubSub: false

# Optional avatar blob storage. Default (omit or driver: db) keeps base64 images in the database.
# With s3/gcs, GET /auth/.../avatar redirects (302) to a short-lived signed URL; JSON imageUrl
# paths stay relative with ?v= cache-busting. Migrate existing blobs with: team-hub migrate-avatars
#
# storage:
#   driver: db
#   # prefix: avatars
#   # signedUrlTtlSeconds: 900
#
# S3 / MinIO:
# storage:
#   driver: s3
#   bucket: team-hub-avatars
#   region: us-east-1
#   # endpoint: http://minio:9000
#   accessKeyId: ...
#   secretAccessKey: ...
#   prefix: avatars
#   signedUrlTtlSeconds: 900
#
# GCS (ADC / workload identity, or keyFilename):
# storage:
#   driver: gcs
#   bucket: team-hub-avatars
#   # projectId: my-gcp-project
#   # keyFilename: /path/to/service-account.json
#   prefix: avatars
#   signedUrlTtlSeconds: 900

# Optional hub-proxied LLM access. Omit this section to disable LLM routes.
# At least one provider apiKey is required when llm is present.
# User access and monthly token limits are configured via the CLI (see docs/llm.md).
#
# When models is omitted, every catalog model whose provider has a configured key
# is offered. Supported model ids:
#   openai:  gpt-4o, gpt-4o-mini
#   claude:  claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
#   gemini:  gemini-1.5-pro, gemini-1.5-flash
#
# Optional llm.mcp connects Team Hub to remote MCP servers during POST /llm/chat/step.
# Hub MCP tools are merged into the provider request and executed on the server;
# HarborClient only receives passthrough (client-side) tool calls. Reload via SIGHUP
# or POST /admin/config/reload after changes.
#
# llm:
#   providers:
#     openai:
#       apiKey: ${TEAM_HUB_LLM_OPENAI_API_KEY:-}
#     claude:
#       apiKey: ${TEAM_HUB_LLM_CLAUDE_API_KEY:-}
#     gemini:
#       apiKey: ${TEAM_HUB_LLM_GEMINI_API_KEY:-}
#   models:
#     - gpt-4o
#     - gpt-4o-mini
#     - claude-3-5-sonnet-20241022
#     - claude-3-5-haiku-20241022
#     - gemini-1.5-pro
#     - gemini-1.5-flash
#   mcp:
#     # Exa web search (https://exa.ai) — nested-array header form from Cursor-style configs:
#     - name: Exa
#       url: https://mcp.exa.ai/mcp
#       headers:
#         - [ { "x-api-key": "your-exa-api-key" } ]
#     # Same headers in other accepted shapes:
#     # - name: Example MCP
#     #   url: https://mcp.example.com/mcp
#     #   headers: { "Authorization": "Bearer your-token" }
#     # - name: Another MCP
#     #   url: https://mcp.example.org/sse
#     #   headers:
#     #     - { "x-api-key": "your-key" }

# Optional plugin source URLs for HarborClient. Omit this section to return empty lists.
# Authenticated HarborClient instances merge these read-only endpoints into Settings → Plugins.
#
# plugins:
#   catalogs:
#     - https://harborclient.com/plugin_catalog.json
#     - https://example.com/custom-catalog.json
#   trusted:
#     - https://harborclient.com/plugins/trusted.json

# Optional documentation vector search index for hub-native search_docs.
# When omitted, Team Hub looks for /app/data/docsSearchIndex.json (Docker default)
# and other fallback paths. Rebuild the index with `pnpm index-docs` in harborclient.
#
# docs:
#   searchIndexPath: /app/data/docsSearchIndex.json

# Optional multitenancy. When omitted or disabled, every request uses the reserved
# default tenant "__default__" and clients never need a tenant header.
# Enable only for advanced multi-tenant deployments; create tenants via the CLI.
#
# multitenancy:
#   enabled: false

# Optional collaboration settings. When e2ee is true, discussion routes reject plaintext
# bodies and clients must use encrypted payloads once device enrollment is available.
#
# collaboration:
#   e2ee: false
