{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Emit must consume built core declarations. The base tsconfig maps
    // @harborclient/core to source for typecheck/IDE; following those paths
    // here pulls core .ts files outside rootDir and fails with TS6059.
    "paths": {
      "#/*": ["./src/*"],
      "@harborclient/core": ["../core/dist/index.d.ts"],
      "@harborclient/core/*": ["../core/dist/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/testFixtures/**"]
}
