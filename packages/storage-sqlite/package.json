{
  "name": "@harborclient/storage-sqlite",
  "version": "0.1.0",
  "description": "SQLite storage engine for HarborClient applications.",
  "license": "MIT",
  "author": {
    "name": "HarborClient",
    "email": "contact@harborclient.com"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*",
      "import": "./src/*",
      "default": "./src/*"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "eslint --cache .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@harborclient/core": "workspace:*",
    "@harborclient/sdk": "workspace:^",
    "better-sqlite3": "^12.11.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "eslint": "^9.39.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  }
}
