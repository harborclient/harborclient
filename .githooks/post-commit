#!/usr/bin/env bash
# Auto-append the subject of the just-made commit to the `## Unreleased`
# section of relevant CHANGELOG.md files and fold the change into the same
# commit via `git commit --amend`. Recursion is prevented with an env-var guard.
#
# Changelogs:
#   - Root CHANGELOG.md — every meaningful commit (desktop / monorepo history)
#   - packages/core/CHANGELOG.md — commits that touch packages/core/**
#   - packages/sdk/CHANGELOG.md — commits that touch packages/sdk/**
#   - packages/http/CHANGELOG.md — commits that touch packages/http/**
#
# The env-var name (CHANGELOG_HOOK_SKIP) can be renamed to a project-specific
# prefix; just keep the two references in this file in sync.

set -euo pipefail

# Recursion guard: this hook calls `git commit --amend` below, which would
# trigger post-commit again. The amend invocation sets this env var inline.
[[ -n "${CHANGELOG_HOOK_SKIP:-}" ]] && exit 0

# Don't run mid-rebase / mid-cherry-pick / mid-revert / mid-merge — those
# replay many commits and would spam the changelog. Let the user manage
# entries during history rewrites.
git_dir="$(git rev-parse --git-dir)"
if [[ -e "$git_dir/MERGE_HEAD" \
   || -e "$git_dir/CHERRY_PICK_HEAD" \
   || -e "$git_dir/REVERT_HEAD" \
   || -d "$git_dir/rebase-merge" \
   || -d "$git_dir/rebase-apply" ]]; then
  exit 0
fi

# Skip merge commits (they have a second parent). Merge subjects are not
# useful changelog content.
if git rev-parse --verify -q HEAD^2 >/dev/null; then
  exit 0
fi

repo_root="$(git rev-parse --show-toplevel)"
subject="$(git log -1 --pretty=%s)"
short_sha="$(git log -1 --pretty=%h)"

# Skip subjects that aren't meaningful changelog content:
#   Merge / Revert / fixup! / squash!     -> noise / temporary
#   chore(changelog) / chore(release)     -> the workflow's commit back to main
case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"chore(changelog)"*|"chore(release)"*)
    exit 0
    ;;
esac

# Skip version-bump-only subjects (e.g. `0.4.9`, `v1.2.3`) so a local
# `pnpm version patch` / `npm version` / etc. doesn't pollute the changelog.
if [[ "$subject" =~ ^v?[0-9]+\.[0-9]+\.[0-9]+ ]]; then
  exit 0
fi

changed_files="$(git diff-tree --no-commit-id --name-only -r HEAD)"
bullet="- ${subject}. (\`${short_sha}\`)"
files_to_amend=()

# Append a changelog bullet under ## Unreleased when the file is eligible:
# exists, has ## Unreleased, was not manually included in this commit, and
# does not already reference this commit's short SHA.
# Args: $1 = absolute CHANGELOG.md path, $2 = repo-relative path for checks.
append_changelog_bullet() {
  local changelog="$1"
  local relative_path="$2"

  [[ -f "$changelog" ]] || return 0
  grep -q '^## Unreleased' "$changelog" || return 0

  # If the developer included this changelog in the commit themselves, trust
  # them and don't auto-append.
  if printf '%s\n' "$changed_files" | grep -qx "$relative_path"; then
    return 0
  fi

  # Idempotency: if this commit's short SHA is already referenced in
  # `## Unreleased`, do nothing.
  if grep -qF "\`$short_sha\`" "$changelog"; then
    return 0
  fi

  python3 - "$changelog" "$bullet" <<'PY'
import re
import sys
import pathlib

path = pathlib.Path(sys.argv[1])
bullet = sys.argv[2]
text = path.read_text()


def repl(match: re.Match) -> str:
    heading = match.group(1)
    body = match.group(2).lstrip("\n")
    if body:
        return f"{heading}\n\n{bullet}\n{body}"
    return f"{heading}\n\n{bullet}\n\n"


new_text = re.sub(
    r"(^## Unreleased[^\n]*)\n+((?:.*?)(?=^## |\Z))",
    repl,
    text,
    count=1,
    flags=re.S | re.M,
)
path.write_text(new_text)
PY

  files_to_amend+=("$changelog")
}

# Root monorepo / desktop changelog.
append_changelog_bullet "$repo_root/CHANGELOG.md" "CHANGELOG.md"

# @harborclient/core npm package changelog — only when the commit touches core.
if printf '%s\n' "$changed_files" | grep -q '^packages/core/'; then
  append_changelog_bullet \
    "$repo_root/packages/core/CHANGELOG.md" \
    "packages/core/CHANGELOG.md"
fi

# @harborclient/sdk npm package changelog — only when the commit touches sdk.
if printf '%s\n' "$changed_files" | grep -q '^packages/sdk/'; then
  append_changelog_bullet \
    "$repo_root/packages/sdk/CHANGELOG.md" \
    "packages/sdk/CHANGELOG.md"
fi

# @harborclient/http npm package changelog — only when the commit touches http.
if printf '%s\n' "$changed_files" | grep -q '^packages/http/'; then
  append_changelog_bullet \
    "$repo_root/packages/http/CHANGELOG.md" \
    "packages/http/CHANGELOG.md"
fi

if [[ ${#files_to_amend[@]} -eq 0 ]]; then
  exit 0
fi

git add -- "${files_to_amend[@]}"
CHANGELOG_HOOK_SKIP=1 git commit --amend --no-edit --no-verify --quiet -- "${files_to_amend[@]}"
