{
  "name": "harborclient-monorepo",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm build:sdk && pnpm build:shortcut-runner && pnpm --parallel --filter @harborclient/sdk --filter @harborclient/gui run dev",
    "dev:sdk": "pnpm --filter @harborclient/sdk run dev",
    "dev:gui": "pnpm --filter @harborclient/gui run dev",
    "build": "pnpm build:sdk && pnpm build:shortcut-runner && pnpm --filter @harborclient/harborclient build",
    "build:sdk": "pnpm --filter @harborclient/sdk build",
    "build:shortcut-runner": "pnpm --filter @harborclient/shortcut-runner-game build",
    "build:http": "pnpm --filter @harborclient/http build",
    "build:gui": "pnpm build:sdk && pnpm build:shortcut-runner && pnpm --filter @harborclient/gui build",
    "preview": "pnpm --filter @harborclient/gui preview",
    "dist": "pnpm --filter @harborclient/harborclient dist",
    "dist:deb": "pnpm --filter @harborclient/harborclient dist:deb",
    "dist:rpm": "pnpm --filter @harborclient/harborclient dist:rpm",
    "dist:linux": "pnpm --filter @harborclient/harborclient dist:linux",
    "test": "pnpm build:sdk && pnpm test:packages",
    "test:packages": "pnpm --parallel --filter @harborclient/sdk --filter @harborclient/http --filter @harborclient/core --filter @harborclient/storage-sqlite --filter @harborclient/live-server --filter @harborclient/cli --filter @harborclient/team-hub-api --filter @harborclient/team-hub --filter @harborclient/harborclient test && pnpm --filter @harborclient/gui test",
    "test:changed": "pnpm build:sdk && pnpm --parallel --filter @harborclient/sdk --filter @harborclient/http --filter @harborclient/core --filter @harborclient/storage-sqlite --filter @harborclient/live-server --filter @harborclient/cli --filter @harborclient/team-hub-api --filter @harborclient/team-hub --filter @harborclient/harborclient test:changed && pnpm --filter @harborclient/gui test:changed",
    "test:gui": "pnpm --filter @harborclient/gui test",
    "test:watch": "pnpm --filter @harborclient/gui test:watch",
    "lint": "pnpm -r --parallel --if-present lint",
    "typecheck": "pnpm build:sdk && pnpm build:shortcut-runner && pnpm typecheck:packages",
    "typecheck:packages": "pnpm -r --parallel --if-present typecheck",
    "check": "node scripts/check.mjs",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "prepare": "bash scripts/setup-git-local-config.sh 2>/dev/null || true",
    "cli": "pnpm --filter @harborclient/cli start --",
    "cli:build": "pnpm --filter @harborclient/cli build",
    "docs:core:serve": "pnpm --filter @harborclient/core docs:serve",
    "docs:core:build": "pnpm --filter @harborclient/core docs:build",
    "docs:sdk:serve": "pnpm --filter @harborclient/sdk docs:serve",
    "docs:sdk:build": "pnpm --filter @harborclient/sdk docs:build",
    "docs:http:serve": "pnpm --filter @harborclient/http docs:serve",
    "docs:http:build": "pnpm --filter @harborclient/http docs:build",
    "docs:live-server:serve": "pnpm --filter @harborclient/live-server docs:serve",
    "docs:live-server:build": "pnpm --filter @harborclient/live-server docs:build",
    "docs:team-hub:serve": "pnpm --filter @harborclient/team-hub docs:serve",
    "docs:team-hub:build": "pnpm --filter @harborclient/team-hub docs:build",
    "docs:team-hub-api:serve": "pnpm --filter @harborclient/team-hub-api docs:serve",
    "docs:team-hub-api:build": "pnpm --filter @harborclient/team-hub-api docs:build",
    "docs:build": "node scripts/build-docs-site.mjs",
    "kill": "pnpm --filter @harborclient/gui kill",
    "screenshots": "pnpm --filter @harborclient/gui screenshots",
    "index-docs": "pnpm --filter @harborclient/gui index-docs"
  },
  "devDependencies": {
    "@orama/orama": "^3.1.18",
    "openai": "^6.49.0",
    "prettier": "^3.8.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild",
      "node-pty"
    ],
    "overrides": {
      "@types/node": "^22.10.0",
      "@harborclient/sdk>@types/react": "^19.1.2",
      "@harborclient/sdk>@types/react-dom": "^19.1.2"
    }
  }
}
